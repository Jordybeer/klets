      "css": ".ds-setting{font-family:var(--font-body,'Nunito Sans',ui-sans-serif,sans-serif);position:relative;display:flex;align-items:center;gap:16px;padding:24px 0;border-bottom:1px solid var(--color-line,#d9c9ce);color:var(--color-ink,#44283f);font-size:15px;font-weight:700;cursor:pointer;}.ds-setting>span:first-child{flex:1;}.ds-setting input{position:absolute;opacity:0;right:0;width:48px;height:44px;}.ds-switch{flex:0 0 44px;width:44px;height:26px;border-radius:20px;background:var(--color-line,#d9c9ce);padding:3px;transition:background 150ms var(--ease-out,cubic-bezier(.16,1,.3,1));}.ds-switch:after{content:\"\";display:block;width:20px;height:20px;border-radius:50%;background:var(--color-surface,#fffaf6);box-shadow:0 2px 4px #44283f20;transition:transform 150ms var(--ease-out,cubic-bezier(.16,1,.3,1));}.ds-setting input:checked+.ds-switch{background:var(--color-lavender-strong,#6e4b9d);}.ds-setting input:checked+.ds-switch:after{transform:translateX(18px);}.ds-setting input:focus-visible+.ds-switch{outline:3px solid var(--color-lavender-strong,#6e4b9d);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-switch,.ds-switch:after{transition:none;}}"
