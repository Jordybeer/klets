  "narrative": {
    "northStar": "Een speels ritueel voor twee",
    "overview": "De zachte 3D-snoepmascotte is het tastbare middelpunt. De warme achtergrond en rustige bediening laten het idee leesbaar blijven. Humor zit in de beweging; de tekst blijft kort, volwassen en natuurlijk.\n\nNieuwe functies gebruiken dezelfde kleuren, letters, selectie- en terugkeerpatronen. De expressieve scène blijft gescheiden van de betekenis van het bericht.",
    "keyCharacteristics": [
      "Tastbare, geklede mascotte met zachte materialen.",
      "Rustige tekst naast een expressieve interactie.",
      "Dezelfde keuzes en terugkeer op ruime en lage schermen.",
      "Beweging en geluid blijven onder eigen controle."
    ],
    "rules": [
      {
        "name": "The Selectie Rule",
        "body": "Selectie gebruikt een licht lavendelvlak, een lavendelrand en herkenbare tekst of een indicator; kleur draagt de staat nooit alleen.",
        "section": "colors"
      },
      {
        "name": "The Leesbare boodschap Rule",
        "body": "Een idee blijft selecteerbare HTML-tekst; de scène toont geen noodzakelijke inhoud.",
        "section": "typography"
      },
      {
        "name": "The Eén tik Rule",
        "body": "Motion bevestigt één actie; extra input tijdens herstel produceert geen tweede idee.",
        "section": "components"
      }
    ],
    "dos": [
      "Gebruik de bestaande tokens en dezelfde knoppen voor nieuwe functies.",
      "Toon selectie met vorm en tekst, en geef toetsenbordfocus een zichtbare lijn.",
      "Behoud leesbare resultaattekst, ook zonder 3D, beweging of geluid.",
      "Gebruik de compacte categoriekeuze op lage schermen en laat extra inhoud bereikbaar blijven."
    ],
    "donts": [
      "Voeg geen tweede visuele wereld toe voor opgeslagen ideeën of toekomstige modules.",
      "Gebruik kleur of beweging niet als bewijs van stemming, instemming of uitvoering.",
      "Maak de boodschap niet afhankelijk van een geslaagde 3D-render of hoorbaar geluid.",
      "Verstop noodzakelijke inhoud niet met overflow om de scrollvrije compositie te behouden."
    ]
  }
}
