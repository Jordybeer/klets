      "html": "<button class=\"ds-button-primary\" type=\"button\">Kopiëren</button>",
      "css": ".ds-button-primary{font-family:var(--font-body,'Nunito Sans',ui-sans-serif,sans-serif);border:0;cursor:pointer;min-height:44px;padding:11px 22px;border-radius:24px;font-size:13px;line-height:1.5;font-weight:700;background:var(--color-ink,#44283f);color:var(--color-surface,#fffaf6);transition:background 160ms var(--ease-out,cubic-bezier(.16,1,.3,1)),transform 160ms var(--ease-out,cubic-bezier(.16,1,.3,1));}.ds-button-primary:hover{background:#60405b;}.ds-button-primary:focus-visible{outline:3px solid var(--color-lavender-strong,#6e4b9d);outline-offset:4px;}.ds-button-primary:active{transform:translateY(1px);}.ds-button-primary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}",
